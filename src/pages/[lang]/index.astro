---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getStaticPaths as getPaths, getTranslations, type Locale } from '../../i18n';

export const getStaticPaths = getPaths;

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-sm border-b border-gray-100 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href={`/${lang}`} class="text-xl font-bold text-primary">DIY Kiosk</a>
      <nav class="hidden md:flex items-center gap-6">
        <a href="#features" class="text-gray-600 hover:text-primary">{t.nav.features}</a>
        <a href="#how-it-works" class="text-gray-600 hover:text-primary">{t.nav.howItWorks}</a>
        <a href="#waitlist" class="text-gray-600 hover:text-primary">{t.nav.register}</a>
        <LanguageSwitcher currentLocale={lang} currentPath="" />
      </nav>
      <a href="#waitlist" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition">
        {t.nav.tryNow}
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="pt-32 pb-20 px-4 bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        {t.hero.title}
      </h1>
      <p class="text-xl text-gray-600 mb-8">
        {t.hero.subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://demo.diy-kiosk.store" target="_blank" class="bg-primary text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-primary-dark transition">
          {t.hero.viewDemo}
        </a>
        <a href="#download" class="border-2 border-primary text-primary px-8 py-3 rounded-lg text-lg font-medium hover:bg-blue-50 transition">
          {t.hero.download}
        </a>
      </div>
    </div>

    <!-- Hero Screenshot - Demo Carousel -->
    <div class="max-w-4xl mx-auto mt-12">
      <div class="relative">
        <!-- Carousel Container -->
        <div id="demo-carousel" class="rounded-xl overflow-hidden shadow-2xl border border-gray-200 relative bg-gray-100">
          <img
            id="carousel-img"
            src="/assets/images/scene-1-menu.gif"
            alt="DIY Kiosk Demo"
            class="w-full"
          >
        </div>

        <!-- Navigation Arrows -->
        <button id="carousel-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 w-10 h-10 rounded-full shadow-lg flex items-center justify-center transition opacity-80 hover:opacity-100 z-10">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button id="carousel-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 w-10 h-10 rounded-full shadow-lg flex items-center justify-center transition opacity-80 hover:opacity-100 z-10">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <!-- Dot Indicators -->
        <div class="flex justify-center gap-2 mt-4">
          <button class="carousel-dot w-3 h-3 rounded-full bg-primary transition-colors" data-index="0" title={t.carousel.scenes.menu}></button>
          <button class="carousel-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors" data-index="1" title={t.carousel.scenes.cart}></button>
          <button class="carousel-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors" data-index="2" title={t.carousel.scenes.payment}></button>
          <button class="carousel-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors" data-index="3" title={t.carousel.scenes.admin}></button>
        </div>

        <!-- Scene Labels -->
        <div class="text-center mt-2">
          <span id="carousel-label" class="text-sm text-gray-500">1/4 - {t.carousel.scenes.menu}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4">{t.features.title}</h2>
      <p class="text-gray-600 text-center mb-12">{t.features.subtitle}</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature: Offline -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.offline.title}</h3>
          <p class="text-gray-600">{t.features.offline.description}</p>
        </div>

        <!-- Feature: Multi-Order -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.multiOrder.title}</h3>
          <p class="text-gray-600">{t.features.multiOrder.description}</p>
        </div>

        <!-- Feature: Voice Confirmation -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition relative">
          <span class="absolute top-3 right-3 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">{t.features.voice.badge}</span>
          <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.voice.title}</h3>
          <p class="text-gray-600">{t.features.voice.description}</p>
        </div>

        <!-- Feature: QR Payment -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.qr.title} <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full">{t.features.qr.badge}</span></h3>
          <p class="text-gray-600">{t.features.qr.description}</p>
        </div>

        <!-- Feature: Print -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.print.title}</h3>
          <p class="text-gray-600">{t.features.print.description}</p>
        </div>

        <!-- Feature: Free -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.free.title}</h3>
          <p class="text-gray-600">{t.features.free.description}</p>
        </div>

        <!-- Feature: Quick Setup -->
        <div class="p-6 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">{t.features.quickSetup.title}</h3>
          <p class="text-gray-600">{t.features.quickSetup.description}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Users Section -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-12">{t.targetUsers.title}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">☕</span>
          <span class="font-medium">{t.targetUsers.cafe}</span>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">🧋</span>
          <span class="font-medium">{t.targetUsers.milkTea}</span>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">🍜</span>
          <span class="font-medium">{t.targetUsers.restaurant}</span>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">🥐</span>
          <span class="font-medium">{t.targetUsers.bakery}</span>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">🚚</span>
          <span class="font-medium">{t.targetUsers.foodTruck}</span>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <span class="text-3xl mb-2 block">🏪</span>
          <span class="font-medium">{t.targetUsers.shop}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">{t.howItWorks.title}</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-semibold mb-2">{t.howItWorks.step1.title}</h3>
          <p class="text-gray-600">{t.howItWorks.step1.description}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-semibold mb-2">{t.howItWorks.step2.title}</h3>
          <p class="text-gray-600">{t.howItWorks.step2.description}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-semibold mb-2">{t.howItWorks.step3.title}</h3>
          <p class="text-gray-600">{t.howItWorks.step3.description}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Section -->
  <section id="demo" class="py-20 px-4 bg-gradient-to-b from-white to-blue-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">{t.demo.title}</h2>
      <p class="text-gray-600 mb-8">{t.demo.subtitle}</p>

      <!-- Demo - Animated Preview -->
      <div class="rounded-xl overflow-hidden shadow-2xl border border-gray-200 mb-8">
        <img
          src="/assets/images/diy-kiosk-demo-5scenes.gif"
          alt="DIY Kiosk Demo"
          class="w-full"
          loading="lazy"
        >
      </div>

      <a href="https://demo.diy-kiosk.store" target="_blank" class="inline-block bg-primary text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-primary-dark transition">
        {t.demo.openDemo}
      </a>
      <p class="text-sm text-gray-500 mt-4">{t.demo.note}</p>
    </div>
  </section>

  <!-- Download Section -->
  <section id="download" class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">{t.download.title}</h2>
      <p class="text-gray-600 mb-8">{t.download.subtitle}</p>

      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-6 inline-block">
        <p class="text-blue-800 font-medium mb-2">⏳ {t.download.pendingApprovalTitle}</p>
        <p class="text-blue-700 text-sm">{t.download.pendingApprovalSubtitle}</p>
      </div>

      <div>
        <a href="https://github.com/diy-kiosk/diy-kiosk-releases/releases" target="_blank" class="inline-flex items-center gap-3 bg-primary text-white px-8 py-4 rounded-xl text-lg font-medium hover:bg-primary-dark transition">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          {t.download.downloadBtn}
        </a>
      </div>

      <p class="text-sm text-gray-500 mt-6">{t.download.requirements}</p>
    </div>
  </section>

  <!-- Waitlist Section -->
  <section id="waitlist" class="py-20 px-4 bg-primary">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-white mb-4">{t.waitlist.title}</h2>
      <p class="text-blue-100 mb-8">{t.waitlist.subtitle}</p>

      <div class="bg-white rounded-xl p-8">
        <form id="subscribe-form" class="space-y-4">
          <input
            type="email"
            name="email"
            id="email"
            placeholder={t.waitlist.emailPlaceholder}
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
          >
          <!-- Honeypot field - hidden from humans -->
          <input type="text" name="website" id="website" style="position:absolute;left:-9999px" tabindex="-1" autocomplete="off">
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition"
          >
            {t.waitlist.submitBtn}
          </button>
        </form>
        <p id="form-message" class="mt-4 text-sm hidden"></p>
      </div>

      <p class="text-blue-100 text-sm mt-6">{t.waitlist.noSpam}</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-12 px-4 bg-gray-900 text-gray-400">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xl font-bold text-white">DIY Kiosk</span>
          <p class="text-sm mt-1">{t.footer.tagline}</p>
        </div>
        <div class="flex gap-6">
          <a href="#waitlist" class="hover:text-white transition">{t.footer.contact}</a>
          <a href={`/${lang}/privacy-policy`} class="hover:text-white transition">{t.footer.privacyPolicy}</a>
        </div>
      </div>
      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm">
        <p>{t.footer.copyright}</p>
      </div>
    </div>
  </footer>

  <script define:vars={{ t }}>
    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Demo Carousel
    (function() {
      const scenes = [
        { src: '/assets/images/scene-1-menu.gif', label: t.carousel.scenes.menu },
        { src: '/assets/images/scene-2-cart.gif', label: t.carousel.scenes.cart },
        { src: '/assets/images/scene-3-payment.gif', label: t.carousel.scenes.payment },
        { src: '/assets/images/scene-5-admin.gif', label: t.carousel.scenes.admin }
      ];

      let currentIndex = 0;
      let autoPlayInterval = null;
      const img = document.getElementById('carousel-img');
      const label = document.getElementById('carousel-label');
      const dots = document.querySelectorAll('.carousel-dot');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');

      function updateCarousel(index) {
        currentIndex = index;
        img.src = scenes[index].src;
        label.textContent = `${index + 1}/${scenes.length} - ${scenes[index].label}`;

        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.remove('bg-gray-300', 'hover:bg-gray-400');
            dot.classList.add('bg-primary');
          } else {
            dot.classList.remove('bg-primary');
            dot.classList.add('bg-gray-300', 'hover:bg-gray-400');
          }
        });
      }

      function nextSlide() {
        updateCarousel((currentIndex + 1) % scenes.length);
      }

      function prevSlide() {
        updateCarousel((currentIndex - 1 + scenes.length) % scenes.length);
      }

      function startAutoPlay() {
        autoPlayInterval = setInterval(nextSlide, 4000);
      }

      function stopAutoPlay() {
        if (autoPlayInterval) {
          clearInterval(autoPlayInterval);
          autoPlayInterval = null;
        }
      }

      // Event listeners
      prevBtn?.addEventListener('click', () => {
        stopAutoPlay();
        prevSlide();
        startAutoPlay();
      });

      nextBtn?.addEventListener('click', () => {
        stopAutoPlay();
        nextSlide();
        startAutoPlay();
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          stopAutoPlay();
          updateCarousel(index);
          startAutoPlay();
        });
      });

      // Pause on hover
      const carousel = document.getElementById('demo-carousel');
      carousel?.addEventListener('mouseenter', stopAutoPlay);
      carousel?.addEventListener('mouseleave', startAutoPlay);

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          stopAutoPlay();
          prevSlide();
          startAutoPlay();
        } else if (e.key === 'ArrowRight') {
          stopAutoPlay();
          nextSlide();
          startAutoPlay();
        }
      });

      // Start auto-play
      startAutoPlay();
    })();

    // Email validation
    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    // Subscribe form handler
    document.getElementById('subscribe-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const msg = document.getElementById('form-message');
      const emailInput = document.getElementById('email');
      const email = emailInput.value.trim();
      const website = document.getElementById('website').value;

      // Validate email
      if (!email) {
        msg.classList.remove('hidden', 'text-green-600');
        msg.classList.add('text-red-600');
        msg.textContent = t.form.emailRequired;
        emailInput.focus();
        return;
      }

      if (!isValidEmail(email)) {
        msg.classList.remove('hidden', 'text-green-600');
        msg.classList.add('text-red-600');
        msg.textContent = t.form.emailInvalid;
        emailInput.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = t.waitlist.submitting;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website })
        });
        const data = await res.json();

        msg.classList.remove('hidden', 'text-red-600', 'text-green-600');
        msg.classList.add(data.success ? 'text-green-600' : 'text-red-600');
        msg.textContent = data.message;

        if (data.success) {
          document.getElementById('email').value = '';
        }
      } catch (err) {
        msg.classList.remove('hidden', 'text-green-600');
        msg.classList.add('text-red-600');
        msg.textContent = t.form.error;
      }

      btn.disabled = false;
      btn.textContent = t.waitlist.submitBtn;
    });
  </script>
</BaseLayout>
