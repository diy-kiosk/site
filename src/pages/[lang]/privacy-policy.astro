---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getStaticPaths as getPaths, getTranslations, type Locale } from '../../i18n';

export const getStaticPaths = getPaths;

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);
const p = t.privacy;
---

<BaseLayout lang={lang} title={`${p.title} - DIY Kiosk`} description={t.meta.description} canonicalPath="/privacy-policy">
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-sm border-b border-gray-100 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href={`/${lang}`} class="text-xl font-bold text-primary">DIY Kiosk</a>
      <div class="flex items-center gap-4">
        <a href={`/${lang}`} class="text-gray-600 hover:text-primary">{t.nav.backToHome}</a>
        <LanguageSwitcher currentLocale={lang} currentPath="/privacy-policy" />
      </div>
    </div>
  </header>

  <!-- Content -->
  <main class="pt-24 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold mb-2">{p.title}</h1>
      <p class="text-gray-500 mb-8">{p.lastUpdated}</p>

      <div class="prose prose-gray max-w-none space-y-8">

        <!-- Introduction -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.intro.title}</h2>
          <p class="text-gray-600 leading-relaxed">{p.sections.intro.content}</p>
        </section>

        <!-- Data Collection -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.dataCollection.title}</h2>

          <h3 class="text-lg font-medium mt-4 mb-2">{p.sections.dataCollection.deviceDataTitle}</h3>
          <p class="text-gray-600 leading-relaxed mb-3">{p.sections.dataCollection.deviceDataIntro}</p>
          <ul class="list-disc list-inside text-gray-600 space-y-1 ml-4">
            {p.sections.dataCollection.deviceDataList.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="text-gray-600 leading-relaxed mt-3">
            <strong>{p.sections.dataCollection.deviceDataNote}</strong>
          </p>

          <h3 class="text-lg font-medium mt-4 mb-2">{p.sections.dataCollection.websiteDataTitle}</h3>
          <p class="text-gray-600 leading-relaxed">{p.sections.dataCollection.websiteDataIntro}</p>
          <ul class="list-disc list-inside text-gray-600 space-y-1 ml-4">
            {p.sections.dataCollection.websiteDataList.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Data Usage -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.dataUsage.title}</h2>
          <ul class="list-disc list-inside text-gray-600 space-y-2 ml-4">
            {p.sections.dataUsage.list.map((item: string) => (
              <li set:html={item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
            ))}
          </ul>
        </section>

        <!-- Third Party Services -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.thirdParty.title}</h2>

          <h3 class="text-lg font-medium mt-4 mb-2">{p.sections.thirdParty.googlePlayTitle}</h3>
          <p class="text-gray-600 leading-relaxed">
            {p.sections.thirdParty.googlePlayContent}
            <a href="https://policies.google.com/privacy" target="_blank" class="text-primary hover:underline">Google's Privacy Policy</a>.
          </p>
        </section>

        <!-- Data Storage -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.storage.title}</h2>
          <ul class="list-disc list-inside text-gray-600 space-y-2 ml-4">
            {p.sections.storage.list.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- User Rights -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.rights.title}</h2>
          <p class="text-gray-600 leading-relaxed mb-3">{p.sections.rights.intro}</p>
          <ul class="list-disc list-inside text-gray-600 space-y-2 ml-4">
            {p.sections.rights.list.map((item: string) => (
              <li set:html={item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
            ))}
          </ul>
        </section>

        <!-- Children -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.children.title}</h2>
          <p class="text-gray-600 leading-relaxed">{p.sections.children.content}</p>
        </section>

        <!-- Changes -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.changes.title}</h2>
          <p class="text-gray-600 leading-relaxed">{p.sections.changes.content}</p>
        </section>

        <!-- Contact -->
        <section>
          <h2 class="text-xl font-semibold mb-3">{p.sections.contact.title}</h2>
          <p class="text-gray-600 leading-relaxed">{p.sections.contact.intro}</p>
          <ul class="list-disc list-inside text-gray-600 space-y-1 ml-4 mt-2">
            <li>GitHub: <a href="https://github.com/diy-kiosk/diy-kiosk-releases" target="_blank" class="text-primary hover:underline">github.com/diy-kiosk/diy-kiosk-releases</a></li>
          </ul>
        </section>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="py-8 px-4 bg-gray-900 text-gray-400">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-sm">{t.footer.copyright}</p>
      <div class="flex justify-center gap-4 mt-4 text-sm">
        <a href={`/${lang}`} class="hover:text-white transition">Home</a>
        <a href={`/${lang}/privacy-policy`} class="hover:text-white transition">{t.footer.privacyPolicy}</a>
      </div>
    </div>
  </footer>
</BaseLayout>
