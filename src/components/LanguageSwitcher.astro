---
import { type Locale, locales, localeNames, getLocalizedPath } from '../i18n';

interface Props {
  currentLocale: Locale;
  currentPath?: string;
}

const { currentLocale, currentPath = '' } = Astro.props;
---

<div class="relative inline-block">
  <button
    id="lang-switcher-btn"
    class="flex items-center gap-1 text-gray-600 hover:text-primary transition px-2 py-1 rounded"
    aria-label="Select language"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
    </svg>
    <span class="text-sm font-medium">{localeNames[currentLocale]}</span>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="hidden absolute right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg py-1 min-w-[120px] z-50"
  >
    {locales.map((locale) => (
      <a
        href={getLocalizedPath(currentPath, locale)}
        class:list={[
          "block px-4 py-2 text-sm hover:bg-gray-100 transition",
          locale === currentLocale ? "text-primary font-medium bg-blue-50" : "text-gray-700"
        ]}
      >
        {localeNames[locale]}
      </a>
    ))}
  </div>
</div>

<script>
  const btn = document.getElementById('lang-switcher-btn');
  const dropdown = document.getElementById('lang-dropdown');

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
  });

  // Save language preference to cookie when clicking a language link
  dropdown?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      const locale = href.split('/')[1]; // Extract locale from /en/, /vi/, /sv/
      if (locale) {
        document.cookie = `lang=${locale};path=/;max-age=${60 * 60 * 24 * 365};SameSite=Lax`;
      }
    });
  });
</script>
